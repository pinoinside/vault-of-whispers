        "E1": {
            "isEnding": true,
            "title": "LA SEPOLTURA CONCESSA",
            "text": "Il vecchio pozzo viene aperto e, sotto il fango e le radici, sono ritrovate ossa di donna. Quando ricevono sepoltura, la voce non torna mai piu'."
        },
        "E2": {
            "isEnding": true,
            "title": "IL NOME RITROVATO",
            "text": "Fra registri consunti trovi il nome di una promessa sposa scomparsa. Lo fai incidere su una lapide, e per un istante pare di udire un sospiro di sollievo."
        },
        "E3": {
            "isEnding": true,
            "title": "LA SPOSA ATTENDE ANCORA",
            "text": "Lasci trascorrere i giorni e non torni piu' sul caso. Talvolta, nelle ore piu' tarde, il terminale si accende da solo e compare una sola parola: DEH."
        },
        "E4": {
            "isEnding": true,
            "title": "LA QUARTA OMBRA",
            "text": "Le indagini rivelano che gli assassini non erano tre ma quattro. Il quarto nome appartiene a una stirpe ancora presente nel borgo."
        },
        "E5": {
            "isEnding": true,
            "title": "L'ULTIMO RINTOCCO",
            "text": "Una campana suona nel cuore della notte senza che alcuno la tocchi. Dopo l'ultimo rintocco, il silenzio torna definitivo."
        },
        "E6": {
            "isEnding": true,
            "title": "IL VOLTO NELL'ACQUA",
            "text": "Ti allontani e cerchi di dimenticare. Una sera, guardando nell'acqua di un lavandino, vedi per un istante il volto di una giovane donna al posto del tuo."
        },
        "E7": {
            "isEnding": true,
            "title": "LE NOZZE NERE",
            "text": "La voce ride per la prima volta. Ti chiama suo sposo e ti invita a raggiungerla nel fondo del pozzo, dove nessuna alba e' mai giunta."
